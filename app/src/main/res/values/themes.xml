<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.MedioLimon" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Colores principales de la marca -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/surface_container_lowest</item>
        <item name="colorPrimaryContainer">@color/primary_container</item>
        <item name="colorOnPrimaryContainer">@color/on_primary_container</item>
        
        <!-- Colores secundarios y contenedores -->
        <item name="colorSecondaryContainer">@color/secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/on_surface</item>
        
        <!-- Superficies y Fondos -->
        <item name="android:windowBackground">@color/surface</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorSurfaceVariant">@color/surface_container_low</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_variant</item>
        <item name="colorOutlineVariant">@color/outline_variant</item>

        <!-- Apariencia de Formas (Shapes) -->
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.MedioLimon.Large</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.MedioLimon.Medium</item>
    </style>

    <style name="Theme.MedioLimon" parent="Base.Theme.MedioLimon" />

    <!-- Estilos de esquinas redondeadas -->
    <style name="ShapeAppearance.MedioLimon.Large" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerSize">32dp</item>
    </style>

    <style name="ShapeAppearance.MedioLimon.Medium" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerSize">24dp</item>
    </style>

    <!-- Estilo para el Bottom Navigation con bordes superiores redondeados -->
    <style name="ShapeAppearance.MedioLimon.BottomNav" parent="">
        <item name="cornerSizeTopLeft">32dp</item>
        <item name="cornerSizeTopRight">32dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>
</resources>